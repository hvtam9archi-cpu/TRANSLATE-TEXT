<Window x:Class="TranslateText.UI.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translate Text"
        Width="440" Height="280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border CornerRadius="10" Background="#181A1F" BorderBrush="#333640" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#12141A" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="12,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="4" Background="#2563EB" VerticalAlignment="Center">
                            <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Translate Text" Foreground="#E8EAED" FontFamily="Segoe UI" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="btnClose" Content="✕" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Width="32" Height="26" Padding="0" FontSize="12" Foreground="#6B7280"
                            Background="Transparent" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3B1C1C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="16,12,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Source Language -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source Lang:" Foreground="#E8EAED"
                           FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbSource" Grid.Row="0" Grid.Column="1" Height="30"/>

                <!-- Target Language -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Target Lang:" Foreground="#E8EAED"
                           FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbTarget" Grid.Row="2" Grid.Column="1" Height="30"/>

                <!-- Text Style -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Text Style:" Foreground="#E8EAED"
                           FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbStyle" Grid.Row="4" Grid.Column="1" Height="30"/>
            </Grid>

            <!-- Bottom Bar -->
            <Border Grid.Row="2" Background="#12141A" CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0">
                    <Button x:Name="btnCancel" Content="Cancel" Width="90" Height="34" Margin="0,0,8,0"
                            Click="BtnCancel_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#2B2D32" CornerRadius="6" BorderBrush="#333640" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#3A3D45"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#E8EAED"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="btnTranslate" Content="Translate" Width="120" Height="34"
                            Click="BtnTranslate_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#2563EB" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
